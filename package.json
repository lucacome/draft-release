{
  "name": "lucacome-draft-release",
  "description": "GitHub Action to create a draft release",
  "keywords": [
    "actions",
    "release",
    "notes",
    "draft"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucacome/draft-release.git"
  },
  "license": "MIT",
  "author": "Luca Comellini",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "src/main.ts",
  "scripts": {
    "all": "yarn format && yarn test && yarn build",
    "build": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "eslint": "eslint --max-warnings=0 .",
    "eslint:fix": "eslint --fix .",
    "format": "yarn run prettier:fix && yarn run eslint:fix",
    "lint": "yarn run prettier && yarn run eslint",
    "prettier": "prettier --check \"./**/*.ts\"",
    "prettier:fix": "prettier --write \"./**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@docker/actions-toolkit": "^0.94.0",
    "@types/semver": "^7.8.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.3.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "rollup": "^4.62.4",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.19.0"
  }
}
